# OpenAI
OPENAI_API_KEY=sk-...

# Application
APP_ENV=development
LOG_LEVEL=INFO
CONFIDENCE_THRESHOLD=0.75

# Chroma vector store
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=knowledge_base

# Auto-reply: tickets with confidence >= threshold are replied automatically
AUTO_REPLY_THRESHOLD=0.80
